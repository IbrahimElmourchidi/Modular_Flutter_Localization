# VS Code Extension - Files to Exclude from Package

# Source files (bundled into dist/)
src/**
out/**
tsconfig.json
*.ts

# Node modules (bundled into dist/)
node_modules/**

# Sourcemaps (not needed in production)
**/*.map

# Test infrastructure
.vscode-test/**
**/*.test.ts
**/*.spec.ts
test/**

# Git files
.git/**
.gitignore
.gitattributes
.github/**

# Documentation (keep only essential)
docs/**
*.md
!README.md
!CHANGELOG.md
!LICENSE

# Development files
.env
.env.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
package-lock.json
update_plan.md

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.idea/**
*.iml
*.sublime-*
.vscode/**
!.vscode/launch.json
!.vscode/tasks.json

# Temporary/cache
tmp/**
temp/**
*.tmp
coverage/**
.nyc_output/**
