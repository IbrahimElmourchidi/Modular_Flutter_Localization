# VS Code Extension - Files to Exclude from Package

# Source files (bundled into dist/)
src/**
out/**
tsconfig.json
*.ts

# Node modules (bundled into dist/)
node_modules/**

# Previously built packages — never ship a VSIX inside a VSIX
*.vsix

# Release tooling
publish.sh

# Sourcemaps (not needed in production)
**/*.map

# Test infrastructure
.vscode-test/**
**/*.test.ts
**/*.spec.ts
test/**

# Git files
.git/**
.gitignore
.gitattributes
.github/**

# Documentation (keep only essential)
docs/**
*.md
!README.md
!CHANGELOG.md
!LICENSE

# Development files
.env
.env.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
package-lock.json
update_plan.md

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.idea/**
*.iml
*.sublime-*
.vscode/**
!.vscode/launch.json
!.vscode/tasks.json

# Temporary/cache
tmp/**
temp/**
*.tmp
coverage/**
.nyc_output/**

# Credentials — never package these.
# vsce refuses to upload a package containing an Azure DevOps PAT, but the
# check runs server-side, which means the token has already been transmitted
# by the time it fails. Keep them out of the payload in the first place.
# Character classes because vsce's glob matching is case-sensitive:
# a plain `*token*` does not match `pubToken.txt`.
*[Tt][Oo][Kk][Ee][Nn]*
*[Ss][Ee][Cc][Rr][Ee][Tt]*
*[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]*
*.pat
*.pem
*.key
.env
.env.*
